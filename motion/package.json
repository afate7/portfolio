{
  "name": "portfolio-motion",
  "private": true,
  "version": "1.0.0",
  "description": "Remotion motion-graphics for the portfolio (renders brand loop assets into ../assets). Not part of the runtime site.",
  "scripts": {
    "render:webm": "remotion render src/index.ts BrandLoop ../assets/brand-loop.webm --codec=vp8 --image-format=png",
    "render:poster": "remotion still src/index.ts BrandLoop ../assets/brand-loop-poster.png --frame=60",
    "studio": "remotion studio src/index.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.240",
    "@remotion/google-fonts": "^4.0.240",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.240"
  }
}
