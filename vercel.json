{
  "rewrites": [
    {
      "source": "/css/theme.css",
      "destination": "/api/theme"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/main.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "portfolio-three-zeta-9cw6dwpro4.vercel.app"
        }
      ],
      "destination": "https://me.super-cv.me/$1",
      "permanent": true
    },
    {
      "source": "/projects/tameeni-rebrand-research.html",
      "destination": "/projects/tameeni-rebrand-empathize.html",
      "permanent": true
    },
    {
      "source": "/projects/tameeni-rebrand-brand.html",
      "destination": "/projects/tameeni-rebrand-prototype.html",
      "permanent": true
    },
    {
      "source": "/projects/tameeni-rebrand-flows.html",
      "destination": "/projects/tameeni-rebrand-prototype.html",
      "permanent": true
    },
    {
      "source": "/projects/tameeni-rebrand-results.html",
      "destination": "/projects/tameeni-rebrand-test.html",
      "permanent": true
    },
    {
      "source": "/projects/tameeni.html",
      "destination": "/projects/tameeni-rebrand.html",
      "permanent": true
    }
  ]
}